<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImportBSMTTargets>true</ImportBSMTTargets>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GameDirectory Condition="!$(Configuration.EndsWith('1.45.1')) AND '$(GameDirectory)' == ''">$(BeatSaberDir)</GameDirectory>
    <GameDirectory Condition="$(Configuration.EndsWith('1.45.1'))">D:\BSManager\BSInstances\1.45.1</GameDirectory>
    <CopyPDB>false</CopyPDB>
    <DisableCopyToGame Condition="$(Configuration.EndsWith('1.45.1'))">false</DisableCopyToGame>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);LATEST</DefineConstants>
    <HeckReferencePath Condition="'$(HeckReferencePath)' == ''">$(GameDirectory)\Plugins\Heck.dll</HeckReferencePath>
    <CustomJSONDataReferencePath Condition="'$(CustomJSONDataReferencePath)' == ''">$(GameDirectory)\Plugins\CustomJSONData.dll</CustomJSONDataReferencePath>
    <Configurations>Debug-1.29.1;Release-1.29.1;Debug-1.34.2;Release-1.34.2;Debug-1.37.1;Release-1.37.1;Debug-1.40.8;Release-1.40.8;Debug-1.42.1;Release-1.42.1;Debug-1.45.0;Release-1.45.0;Debug-1.45.1;Release-1.45.1</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <PluginId>Vivify</PluginId>
    <PluginName>Vivify</PluginName>
    <Author>Aeroluna</Author>
    <Version>1.1.0</Version>
    <Description>Bring your map to life!</Description>
  </PropertyGroup>
  <ItemGroup>
    <DependsOn Include="BeatSaberMarkupLanguage" Version="^1.5.9"/>
    <DependsOn Include="BSIPA" Version="^4.2.2"/>
    <DependsOn Include="CustomJSONData" Version="^2.6.3"/>
    <DependsOn Include="Heck" Version="^1.7.2"/>
    <DependsOn Include="SiraUtil" Version="^3.0.5"/>
    <DependsOn Include="CameraUtils" Version="^1.0.3"/>
  </ItemGroup>

  <Choose>
    <When Condition="$(Configuration.EndsWith('1.29.1'))">
      <ItemGroup>
        <EmbeddedResource Include="Resources\DepthBlit2019" LogicalName="Vivify.Resources.DepthBlit" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <DependsOn Include="AssetBundleLoadingTools" Version="^1.0.0"/>
        <EmbeddedResource Include="Resources\DepthBlit2021" LogicalName="Vivify.Resources.DepthBlit" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemDefinitionGroup>
    <Reference Private="False"/>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(GameDirectory)\Libs\0Harmony.dll"/>
    <Reference Include="BeatmapCore" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BeatmapCore.dll"/>
    <Reference Include="BeatSaber.GameSettings" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BeatSaber.GameSettings.dll"/>
    <Reference Include="BeatSaber.PerformancePresets" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BeatSaber.PerformancePresets.dll" Condition="Exists('$(GameDirectory)\Beat Saber_Data\Managed\BeatSaber.PerformancePresets.dll')"/>
    <Reference Include="BeatSaber.ViewSystem" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll"/>
    <Reference Include="BeatSaberMarkupLanguage" HintPath="$(GameDirectory)\Plugins\BSML.dll"/>
    <Reference Include="BGLib.UnityExtension" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BGLib.UnityExtension.dll"/>
    <Reference Include="Colors" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Colors.dll"/>
    <Reference Include="Core" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Core.dll"/>
    <Reference Include="CustomJSONData" HintPath="$(CustomJSONDataReferencePath)"/>
    <Reference Include="DataModels" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\DataModels.dll" Publicize="true"/>
    <Reference Include="GameplayCore" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\GameplayCore.dll"/>
    <Reference Include="Heck" HintPath="$(HeckReferencePath)"/>
    <Reference Include="HMLib" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\HMLib.dll"/>
    <Reference Include="HMUI" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\HMUI.dll"/>
    <Reference Include="HMRendering" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\HMRendering.dll" Publicize="true"/>
    <Reference Include="IPA.Loader" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\IPA.Loader.dll"/>
    <Reference Include="Main" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Main.dll" Publicize="true"/>
    <Reference Include="Rendering" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Rendering.dll" Publicize="true"/>
    <Reference Include="SaberTrail" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\SaberTrail.dll" Publicize="true"/>
    <Reference Include="SiraUtil" HintPath="$(GameDirectory)\Plugins\SiraUtil.dll" Publicize="true"/>
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll"/>
    <Reference Include="Unity.XR.OpenXR" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Unity.XR.OpenXR.dll"/>
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.AnimationModule.dll"/>
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.AssetBundleModule.dll"/>
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.AudioModule.dll"/>
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll"/>
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.JSONSerializeModule.dll"/>
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.ParticleSystemModule.dll"/>
    <Reference Include="UnityEngine.UI" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.UI.dll"/>
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.UIModule.dll"/>
    <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.UnityWebRequestModule.dll"/>
    <Reference Include="UnityEngine.VideoModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.VideoModule.dll"/>
    <Reference Include="UnityEngine.VRModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.VRModule.dll"/>
    <Reference Include="Zenject" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Zenject.dll"/>
    <Reference Include="Zenject-usage" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Zenject-usage.dll"/>
    <Reference Include="ZenjectExtension" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\ZenjectExtension.dll"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\AssetBundleDownloading.bsml"/>
    <EmbeddedResource Include="Resources\Settings.bsml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks.Luna" Version="2.1.0"/>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.*"/>
    <PackageReference Include="LunaBSMod.Tasks" Version="1.1.0"/>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.354"/>
  </ItemGroup>
</Project>
